import pandas as pd

from src.data_processing import clean_crash_data


def test_clean_crash_data_removes_duplicates():
    df = pd.DataFrame(
        {
            "Severity": [
                "Severe",
                "Severe",
                "Minor",
            ],
            "SpeedLimit": [
                45,
                45,
                35,
            ],
        }
    )

    cleaned = clean_crash_data(df)

    assert len(cleaned) == 2